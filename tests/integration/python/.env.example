# Live-check settings for openrouter_compare.py — copy to `.env` and edit:
#   cp -n .env.example .env
# Never commit `.env` (it is gitignored). Folder-local only: this keeps the
# backend key out of the repo-root `.env` next to app settings.
#
# NOTE: this key never goes into gateway config — it only feeds this opt-in
# script, which sends it with its requests like any API client.

# Backend key from your OpenRouter account (required; without it the script skips).
OPENROUTER_API_KEY=
# Upstream base URL for the direct baseline call.
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Running PennyRouter gateway under test
# (repo root: `cargo run -p pennyrouter-gateway` or `docker compose up --build`).
GATEWAY_URL=http://localhost:3000
# Cheap small model for the two probe calls (tiny max_tokens either way).
OPENROUTER_TEST_MODEL=openai/gpt-oss-20b
# Per-call timeout in seconds.
TEST_TIMEOUT_SECONDS=60
