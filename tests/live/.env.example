# Live-test values: test-only (router, models, agent hosts, smoke
# probe). Copy to `.env` and fill in; never commit `.env`.
# Placeholders only in this file. Deploy config lives in the
# repo-root .env, which deploy.sh ships to the server.

# Router address the agents point at, e.g. http://192.0.2.10:3000
ROUTER_URL=
# Agent hosts (log commands live in scripts/agent-logs.sh).
OPENCLAW_HOST=openclaw.lan
HERMES_HOST=hermes.lan
OPENHANDS_HOST=openhands.lan

# Models under test.
FREE_MODEL=openrouter/pair/free
MODAL_MODEL=
BASETEN_MODEL=

# Optional: one tiny chat probe in router-smoke.sh. Leave both empty
# to skip (no key leaves your machine otherwise).
SMOKE_API_KEY=
SMOKE_MODEL=
