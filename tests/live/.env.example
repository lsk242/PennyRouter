# Live-test settings — copy to `.env` and fill in (never commit `.env`).
# Placeholders only in this file. The live serving path is pure BYOK:
# agents carry their own backend keys, so no keys belong here.

# Router address the agents point at, e.g. http://192.0.2.10:3000
ROUTER_URL=
# Debug UI expectation only affects smoke output (informational).
GATEWAY_UI=1

# Deploy target (see scripts/deploy.sh header for the full list).
# Source the real file before `make deploy` so the values flow into
# the generated remote .env:  set -a; . tests/live/.env; set +a
DEPLOY_HOST=
DEPLOY_DIR=/opt/stacks/pennyrouter
COMPOSE_FILE=compose.dev.yaml
HOST_PORT=3000
PORT=3000
IMAGE=ghcr.io/lsk242/pennyrouter:latest
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Catalog input: 0 = baked fixtures (default), 1 = live OpenRouter
# fetch (Iter 18). Flip to 1 before deploying for the live test.
FETCH_OPENROUTER=0

# Provider-pinned upstreams (must reach the gateway container env).
MODAL_BASE_URL=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Models under test (exact ids to confirm before the live run).
FREE_MODEL=openrouter/pair/free
MODAL_MODEL=
BASETEN_MODEL=

# Agent hosts (log commands live in scripts/agent-logs.sh).
OPENCLAW_HOST=openclaw.lan
HERMES_HOST=hermes.lan

# Optional: one tiny chat probe in router-smoke.sh. Leave both empty
# to skip (no key leaves your machine otherwise).
SMOKE_API_KEY=
SMOKE_MODEL=
