# PennyRouter settings — copy to `.env` and adjust:
#   cp .env.example .env
# Never commit `.env` (it is gitignored). Every variable has a sane
# default in the compose files, so a bare `docker compose up` works.
#
# NOTE: gateway backend keys do NOT belong here — they travel with each
# request (see docs/api.md). The judge keys below are the only exception:
# they are read by the offline catalog process (never the gateway, never
# on the request path). This file documents names only — set real values
# in your local gitignored `.env`, never here.

# Port the gateway listens on inside the container.
PORT=3000
# Port published on the host (local dev; server deploys use 3000 via
# scripts/deploy.sh unless HOST_PORT is overridden).
HOST_PORT=3000
# Image reference. Dev compose tags its local build with this;
# prod compose pulls it from GitHub Packages (ghcr.io).
IMAGE=ghcr.io/lsk242/pennyrouter:latest
# Upstream base URL for POST /v1/chat/completions (Iter 1b).
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Catalog artifact the gateway routes from (Iter 5): directory, manifest,
# or DB file. Empty/unset means plain passthrough without routing.
CATALOG_DB=/catalog
# Catalog sync image tag for the local compose build.
CATALOG_IMAGE=pennyrouter-catalog:dev
# Seconds between catalog sync cycles (0 = run once and exit).
SYNC_INTERVAL=3600
# Catalog judge keys (Phase 4): live LLM backends for catalog-process
# judging. Empty/unset = judging stays on recorded fixtures.
# Baseten: workspace or federated key; OpenAI-compatible chat at
# https://inference.baseten.co/v1 (detail: docs/catalog-sync-roadmap.md).
BASETEN_API_KEY=
# Modal: proxy-token pair for the deployed judge endpoint (dashboard
# Settings -> proxy auth tokens), sent as Modal-Key / Modal-Secret.
MODAL_KEY_ID=
MODAL_KEY_SECRET=
# Modal judge endpoint URL (per-deployment, e.g.
# https://<workspace>--<app>-<fn>.modal.run). Required for Modal judging.
MODAL_JUDGE_URL=
